---
import BaseLayout from '@/layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<BaseLayout title="404 — Page Not Found" description="The page you requested could not be found.">
  <main
    class="bg-background text-foreground flex min-h-screen flex-col items-center justify-center px-6"
  >
    <div class="w-full max-w-lg text-center">
      <!-- Gradient accent line -->
      <div
        class="mx-auto mb-10 h-px w-24"
        style="background: linear-gradient(90deg, var(--color-brand), var(--color-brand-purple));"
      >
      </div>

      <p class="text-muted-foreground mb-2 font-mono text-sm tracking-widest uppercase">Error</p>
      <h1 class="mb-4 font-sans text-7xl font-bold tracking-tight">404</h1>

      <!-- Bilingual message -->
      <p class="text-foreground mb-1 text-lg">Page not found</p>
      <p class="text-muted-foreground mb-10 text-base">ページが見つかりません</p>

      <!-- Navigation links -->
      <nav class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          href={`${base}/en/`}
          class="border-border text-foreground hover:border-brand hover:text-brand inline-block rounded-md border px-6 py-2.5 text-sm font-medium transition-colors"
        >
          English — Home
        </a>
        <a
          href={`${base}/ja/`}
          class="border-border text-foreground hover:border-brand hover:text-brand inline-block rounded-md border px-6 py-2.5 text-sm font-medium transition-colors"
        >
          日本語 — ホーム
        </a>
      </nav>

      <!-- Gradient accent line bottom -->
      <div
        class="mx-auto mt-10 h-px w-24"
        style="background: linear-gradient(90deg, var(--color-brand), var(--color-brand-purple));"
      >
      </div>
    </div>
  </main>
</BaseLayout>
