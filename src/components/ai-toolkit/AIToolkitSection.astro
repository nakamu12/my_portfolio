---
import { getLangFromUrl, getTranslations } from '@/i18n/utils';
import ToolGrid from './ToolGrid';
import SectionHeading from '@/components/common/SectionHeading.astro';
import SectionContainer from '@/components/common/SectionContainer.astro';

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang);

interface Tool {
  id: string;
  name: string;
  category: string;
  description: string;
  logoUrl: string;
  url: string;
}

const toolsData =
  lang === 'ja'
    ? (await import('../../data/ja/ai-tools.json')).default
    : (await import('../../data/en/ai-tools.json')).default;

const tools: Tool[] = (toolsData.items ?? []).filter(
  (item: unknown): item is Tool =>
    typeof item === 'object' &&
    item !== null &&
    typeof (item as Tool).url === 'string' &&
    /^https?:\/\//.test((item as Tool).url),
);
const allLabel = t('aiToolkit.filter.all');
const categories: string[] = toolsData.categories ?? [];
---

<section id="ai-toolkit" class="relative overflow-hidden py-24">
  <!-- Dot grid background -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(circle, #686dff 1px, transparent 1px); background-size: 28px 28px;"
  >
  </div>

  <SectionContainer as="div" padding="none" class="relative">
    <SectionHeading level="h2" heading={t('aiToolkit.heading')} titleOnly />

    <!-- Icon grid with category filter -->
    <ToolGrid client:visible categories={categories} tools={tools} allLabel={allLabel} />
  </SectionContainer>
</section>
