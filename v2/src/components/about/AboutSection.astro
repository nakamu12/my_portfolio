---
import { Image } from 'astro:assets';
import { getLangFromUrl, getTranslations } from '@/i18n/utils';
import profileImage from '@/assets/images/profile/profile.jpg';

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang);

const aboutData = await import(`../../data/${lang}/about.json`);
const bio: string[] = aboutData.bio ?? aboutData.default?.bio ?? [];
const attributes: { label: string; value: string }[] =
  aboutData.attributes ?? aboutData.default?.attributes ?? [];
const mbti: {
  type: string;
  label: string;
  traits: { letter: string; name: string; percent: number }[];
} | null = aboutData.mbti ?? aboutData.default?.mbti ?? null;
const strengths: { name: string; subtitle?: string; desc: string }[] =
  aboutData.strengths ?? aboutData.default?.strengths ?? [];
---

<section id="about" aria-labelledby="about-heading" class="py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Section Heading -->
    <div class="about-heading-group mb-16">
      <p class="text-muted-foreground mb-2 text-sm font-medium tracking-widest uppercase">
        {t('about.subheading')}
      </p>
      <h2 id="about-heading" class="text-3xl font-semibold md:text-4xl">
        {t('about.heading')}
      </h2>
      <div class="mt-4 h-[2px] w-12 bg-gradient-to-r from-[#686dff] to-[#b66fff]"></div>
    </div>

    <!-- Profile + Bio -->
    <div class="mb-10 grid grid-cols-1 items-start gap-10 lg:grid-cols-[300px_1fr]">
      <!-- Profile Photo -->
      <div
        class="about-photo relative mx-auto aspect-square w-64 overflow-hidden rounded-2xl ring-1 ring-white/10 lg:w-full"
      >
        <Image
          src={profileImage}
          alt={t('about.profileAlt')}
          width={600}
          height={600}
          class="h-full w-full object-cover"
        />
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"
        >
        </div>
      </div>

      <!-- Bio + Attributes -->
      <div class="flex flex-col gap-8">
        <!-- Bio text -->
        <div class="about-bio space-y-4">
          {bio.map((paragraph) => <p class="text-muted-foreground leading-relaxed">{paragraph}</p>)}
        </div>

        <!-- Attribute chips -->
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          {
            attributes.map((attr) => (
              <div class="about-chip bg-card border-border rounded-xl border p-4">
                <p class="text-muted-foreground mb-1 text-xs font-medium tracking-wider uppercase">
                  {attr.label}
                </p>
                <p class="text-foreground text-sm leading-snug font-medium">{attr.value}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Personality: MBTI + StrengthsFinder -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <!-- MBTI Card -->
      {
        mbti && (
          <div class="mbti-card bg-card border-border relative overflow-hidden rounded-2xl border p-6 md:p-8">
            <div class="pointer-events-none absolute -top-10 -right-10 h-40 w-40 rounded-full bg-[#686dff]/8 blur-3xl" />

            <div class="mb-6 flex items-start justify-between">
              <div>
                <p class="text-muted-foreground mb-1 text-xs font-medium tracking-widest uppercase">
                  Personality
                </p>
                <h3 class="text-foreground text-lg font-semibold">MBTI</h3>
              </div>
              <div class="text-right">
                <p class="bg-gradient-to-r from-[#686dff] to-[#b66fff] bg-clip-text text-4xl font-bold tracking-tight text-transparent">
                  {mbti.type}
                </p>
                <p class="text-muted-foreground text-sm">{mbti.label}</p>
              </div>
            </div>

            <div class="space-y-3.5">
              {mbti.traits.map((trait) => (
                <div class="flex items-center gap-3">
                  <span class="w-4 shrink-0 text-sm font-bold text-[#686dff]">{trait.letter}</span>
                  <div class="bg-border relative h-1.5 flex-1 overflow-hidden rounded-full">
                    <div
                      class="mbti-bar-fill absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-[#686dff] to-[#b66fff]"
                      data-width={trait.percent}
                      style="width: 0"
                    />
                  </div>
                  <span class="text-muted-foreground w-8 shrink-0 text-right text-xs tabular-nums">
                    {trait.percent}%
                  </span>
                  <span class="text-muted-foreground w-20 shrink-0 text-xs">{trait.name}</span>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <!-- StrengthsFinder Card -->
      <div
        class="sf-card bg-card border-border relative overflow-hidden rounded-2xl border p-6 md:p-8"
      >
        <div
          class="pointer-events-none absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-[#b66fff]/8 blur-3xl"
        >
        </div>

        <div class="mb-6">
          <p class="text-muted-foreground mb-1 text-xs font-medium tracking-widest uppercase">
            Personality
          </p>
          <div class="flex items-center gap-3">
            <h3 class="text-foreground text-lg font-semibold">StrengthsFinder</h3>
            <span
              class="rounded-full bg-[#686dff]/10 px-2.5 py-0.5 text-xs font-semibold text-[#686dff]"
            >
              TOP 5
            </span>
          </div>
        </div>

        <div class="space-y-4">
          {
            strengths.map((s, i) => (
              <div class="sf-item flex items-start gap-4">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#686dff] to-[#b66fff] text-xs font-bold text-white">
                  {i + 1}
                </span>
                <div class="min-w-0 flex-1">
                  <div class="mb-0.5 flex items-baseline gap-2">
                    <span class="text-foreground text-sm font-semibold">{s.name}</span>
                    {s.subtitle && <span class="text-muted-foreground text-xs">{s.subtitle}</span>}
                  </div>
                  <p class="text-muted-foreground text-xs leading-relaxed">{s.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, inView, stagger } from 'motion';

  const section = document.querySelector<HTMLElement>('#about');
  if (section) {
    const ease = [0.25, 0.1, 0.25, 1] as const;

    // --- Section heading ---
    const headingGroup = section.querySelector<HTMLElement>('.about-heading-group');
    if (headingGroup) {
      headingGroup.style.opacity = '0';
      headingGroup.style.transform = 'translateY(20px)';
      inView(headingGroup, () => {
        animate(headingGroup, { opacity: 1, y: 0 }, { duration: 0.7, ease });
      });
    }

    // --- Profile photo ---
    const photo = section.querySelector<HTMLElement>('.about-photo');
    if (photo) {
      photo.style.opacity = '0';
      photo.style.transform = 'scale(0.96)';
      inView(photo, () => {
        animate(photo, { opacity: 1, scale: 1 }, { duration: 0.8, ease });
      });
    }

    // --- Bio paragraphs ---
    const bioParagraphs = section.querySelectorAll<HTMLElement>('.about-bio p');
    if (bioParagraphs.length) {
      bioParagraphs.forEach((p) => {
        p.style.opacity = '0';
        p.style.transform = 'translateY(16px)';
      });
      inView(bioParagraphs[0], () => {
        animate(bioParagraphs, { opacity: 1, y: 0 }, { delay: stagger(0.12), duration: 0.5, ease });
      });
    }

    // --- Attribute chips ---
    const chips = section.querySelectorAll<HTMLElement>('.about-chip');
    if (chips.length) {
      chips.forEach((c) => {
        c.style.opacity = '0';
        c.style.transform = 'translateY(12px)';
      });
      inView(chips[0], () => {
        animate(chips, { opacity: 1, y: 0 }, { delay: stagger(0.08), duration: 0.4, ease });
      });
    }

    // --- MBTI card ---
    const mbtiCard = section.querySelector<HTMLElement>('.mbti-card');
    if (mbtiCard) {
      mbtiCard.style.opacity = '0';
      mbtiCard.style.transform = 'translateY(24px)';
      inView(mbtiCard, () => {
        animate(mbtiCard, { opacity: 1, y: 0 }, { duration: 0.6, ease });

        // Animate bars with stagger after card fades in
        const bars = mbtiCard.querySelectorAll<HTMLElement>('.mbti-bar-fill');
        bars.forEach((bar, i) => {
          const targetWidth = (bar.dataset.width ?? '0') + '%';
          animate(
            bar,
            { width: targetWidth },
            {
              duration: 1,
              delay: 0.3 + i * 0.1,
              ease: [0.4, 0, 0.2, 1],
            },
          );
        });
      });
    }

    // --- StrengthsFinder card ---
    const sfCard = section.querySelector<HTMLElement>('.sf-card');
    if (sfCard) {
      sfCard.style.opacity = '0';
      sfCard.style.transform = 'translateY(24px)';
      inView(sfCard, () => {
        animate(sfCard, { opacity: 1, y: 0 }, { duration: 0.6, delay: 0.1, ease });

        const items = sfCard.querySelectorAll<HTMLElement>('.sf-item');
        items.forEach((item) => {
          item.style.opacity = '0';
          item.style.transform = 'translateY(12px)';
        });
        animate(
          items,
          { opacity: 1, y: 0 },
          {
            delay: stagger(0.1, { start: 0.35 }),
            duration: 0.4,
            ease,
          },
        );
      });
    }
  }
</script>
