---
interface Props {
  class?: string;
  innerClass?: string;
}

const {
  class: className = '',
  innerClass = '',
} = Astro.props;
---

<div
  class:list={[
    'bg-background border-border absolute top-1.5 left-0 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border-2',
    className,
  ]}
>
  <span class:list={['h-1.5 w-1.5 rounded-full bg-[#686dff]', innerClass]}></span>
</div>
