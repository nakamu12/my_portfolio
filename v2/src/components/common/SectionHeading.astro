---
interface Props {
  subheading: string;
  heading: string;
}

const { subheading, heading } = Astro.props;
---

<div class="mb-14">
  <p class="mb-3 text-sm font-medium tracking-widest text-[#686dff] uppercase">
    {subheading}
  </p>
  <h2 class="text-4xl font-semibold tracking-tight md:text-5xl">
    {heading}
  </h2>
</div>
