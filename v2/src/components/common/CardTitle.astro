---
interface Props {
  text?: string;
  as?: 'h3' | 'h4' | 'p' | 'span';
  size?: 'xl' | 'lg' | 'md' | 'sm';
  class?: string;
}

const { text, as = 'h3', size = 'md', class: className = '' } = Astro.props;

const Tag = as;
const sizeClass = {
  xl: 'text-2xl md:text-3xl',
  lg: 'text-xl md:text-2xl',
  md: 'text-base md:text-lg',
  sm: 'text-sm',
} satisfies Record<'xl' | 'lg' | 'md' | 'sm', string>;
---

<Tag
  class:list={[
    'text-foreground leading-snug font-semibold tracking-tight',
    sizeClass[size],
    className,
  ]}
>
  {text ?? <slot />}
</Tag>
