---
interface Props {
  label: string;
  icon?: 'arrow' | 'external' | 'none';
  class?: string;
}

const { label, icon = 'external', class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-1.5', className]}>
  <span>{label}</span>
  {
    icon === 'external' && (
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        <polyline points="15 3 21 3 21 9" />
        <line x1="10" y1="14" x2="21" y2="3" />
      </svg>
    )
  }
  {
    icon === 'arrow' && (
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </svg>
    )
  }
</span>
