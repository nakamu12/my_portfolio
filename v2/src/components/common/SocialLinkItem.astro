---
import SocialIcon from '@/components/common/SocialIcon.astro';
import { sanitizeExternalUrl } from '@/lib/url';

interface SocialLink {
  name: string;
  url: string;
  icon: string;
}

interface Props {
  link: SocialLink;
  variant?: 'contact' | 'footer';
  class?: string;
}

const { link, variant = 'contact', class: className = '' } = Astro.props;
const safeUrl = sanitizeExternalUrl(link.url);

const hostname = (() => {
  try {
    return safeUrl ? new URL(safeUrl).hostname : '';
  } catch {
    return link.url;
  }
})();
---

{
  variant === 'footer' ? (
    safeUrl ? (
      <a
        href={safeUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${link.name} (opens in new tab)`}
        title={link.name}
        class:list={['text-muted-foreground hover:text-foreground transition-colors', className]}
      >
        <SocialIcon icon={link.icon} />
      </a>
    ) : (
      <span class:list={['text-muted-foreground inline-flex', className]}>
        <SocialIcon icon={link.icon} />
      </span>
    )
  ) : safeUrl ? (
    <a
      href={safeUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Visit ${link.name}`}
      class:list={[
        'group border-border flex items-center gap-4 rounded-lg border p-4 transition-colors hover:border-[#686dff]/40 hover:bg-[#686dff]/5',
        className,
      ]}
    >
      <span
        aria-hidden="true"
        class="text-muted-foreground flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition-colors group-hover:text-[#686dff]"
      >
        <SocialIcon icon={link.icon} />
      </span>
      <div>
        <p class="text-foreground text-sm font-medium">{link.name}</p>
        <p class="text-muted-foreground text-xs">{hostname}</p>
      </div>
      <svg
        aria-hidden="true"
        class="text-muted-foreground ml-auto h-4 w-4 transition-colors group-hover:text-[#686dff]"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
        />
      </svg>
    </a>
  ) : (
    <div class:list={['border-border flex items-center gap-4 rounded-lg border p-4', className]}>
      <span
        aria-hidden="true"
        class="text-muted-foreground flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
      >
        <SocialIcon icon={link.icon} />
      </span>
      <div>
        <p class="text-foreground text-sm font-medium">{link.name}</p>
      </div>
    </div>
  )
}
