---
import FluidBackground from './FluidBackground';
import { getLangFromUrl, getTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang);

const statsData = await import(`../../data/${lang}/stats.json`);
const stats = statsData.items ?? statsData.default?.items ?? [];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="hero" class="relative flex min-h-screen items-center justify-center overflow-hidden">
  <!-- Fluid Animation Background -->
  <div class="absolute inset-0 z-0">
    <FluidBackground client:load className="h-full w-full" />
  </div>

  <!-- Gradient overlay for text readability -->
  <div class="absolute inset-0 z-[1] bg-gradient-to-b from-background/60 via-background/30 to-background/80"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-6xl px-6 text-center">
    <!-- Greeting -->
    <p class="mb-2 text-sm font-medium tracking-widest text-muted-foreground uppercase">
      {t('hero.greeting')}
    </p>

    <!-- Name -->
    <h1 class="text-5xl font-bold tracking-tight md:text-7xl lg:text-8xl">
      <span class="bg-gradient-to-r from-[#686dff] to-[#b66fff] bg-clip-text text-transparent">
        {t('hero.name')}
      </span>
    </h1>

    <!-- Title -->
    <p class="mt-4 text-xl font-medium text-foreground/80 md:text-2xl">
      {t('hero.title')}
    </p>

    <!-- Subtitle -->
    <p class="mx-auto mt-4 max-w-2xl text-base text-muted-foreground md:text-lg">
      {t('hero.subtitle')}
    </p>

    <!-- CTA Buttons -->
    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={`${base}/${lang}/#projects`}
        class="inline-flex h-12 items-center rounded-lg bg-[#686dff] px-8 text-sm font-medium text-white transition-colors hover:bg-[#5961ff]"
      >
        {t('hero.cta.projects')}
      </a>
      <a
        href={`${base}/${lang}/#contact`}
        class="inline-flex h-12 items-center rounded-lg border border-border bg-background/50 px-8 text-sm font-medium text-foreground backdrop-blur-sm transition-colors hover:bg-accent"
      >
        {t('hero.cta.contact')}
      </a>
    </div>

    <!-- Stats -->
    <div class="mt-16 grid grid-cols-2 gap-8 sm:grid-cols-4">
      {stats.map((stat: { value: string; label: string }) => (
        <div class="text-center">
          <div class="text-3xl font-bold text-foreground md:text-4xl">
            {stat.value}
          </div>
          <div class="mt-1 text-sm text-muted-foreground">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2">
    <div class="flex flex-col items-center gap-2">
      <span class="text-xs text-muted-foreground">Scroll</span>
      <div class="h-8 w-[1px] animate-pulse bg-muted-foreground/50"></div>
    </div>
  </div>
</section>
