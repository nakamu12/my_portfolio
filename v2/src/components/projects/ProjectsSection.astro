---
import { getLangFromUrl, getTranslations } from '@/i18n/utils';
import FeaturedProjectCard from './FeaturedProjectCard.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang);

interface Project {
  slug: string;
  title: string;
  description: string;
  tech: string[];
  status: 'active' | 'archived';
  period: string | null;
  image: string | null;
  links: { site: string | null; github: string | null };
}

function sanitizeUrl(url: string | null): string | null {
  if (!url) return null;
  return url.startsWith('https://') || url.startsWith('http://') ? url : null;
}

function sanitizeImageFilename(filename: string | null): string | null {
  if (!filename) return null;
  return /^[\w-]+\.(png|jpg|jpeg|webp|gif|svg)$/i.test(filename) ? filename : null;
}

let items: Project[] = [];
try {
  const data = (await import(`../../data/${lang}/projects.json`)) as { items: Project[] };
  items = data.items.map((p) => ({
    ...p,
    image: sanitizeImageFilename(p.image),
    links: {
      site: sanitizeUrl(p.links.site),
      github: sanitizeUrl(p.links.github),
    },
  }));
} catch (e) {
  console.error(`[ProjectsSection] Failed to load projects for lang="${lang}":`, e);
}

const active = items.filter((p) => p.status === 'active');
const archived = items.filter((p) => p.status === 'archived');
---

<section id="projects" class="py-24">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Section Heading -->
    <SectionHeading subheading={t('projects.subheading')} heading={t('projects.heading')} />

    <!-- Current Projects -->
    {
      active.length > 0 && (
        <div class="mb-16">
          <p class="text-muted-foreground mb-6 text-xs font-semibold tracking-widest uppercase">
            {t('projects.section.current')}
          </p>
          <div class="flex flex-col gap-6">
            {active.map((project) => (
              <FeaturedProjectCard
                title={project.title}
                description={project.description}
                tech={project.tech}
                image={project.image}
                links={project.links}
                t={t}
              />
            ))}
          </div>
        </div>
      )
    }

    <!-- Past Projects -->
    {
      archived.length > 0 && (
        <div>
          <p class="text-muted-foreground mb-6 text-xs font-semibold tracking-widest uppercase">
            {t('projects.section.past')}
          </p>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
            {archived.map((project) => (
              <ProjectCard
                title={project.title}
                description={project.description}
                tech={project.tech}
                period={project.period}
                image={project.image}
                links={project.links}
                t={t}
              />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
