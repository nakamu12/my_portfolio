---
interface Props {
  title: string;
  description: string;
  tech: string[];
  image: string | null;
  links: {
    site: string | null;
    github: string | null;
  };
  t: (key: string) => string;
}

const { title, description, tech, image, links, t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class="rounded-2xl border border-[rgba(104,109,255,0.2)] bg-card overflow-hidden">
  <div class="md:flex">
    <!-- Thumbnail -->
    <div class="md:w-1/2 shrink-0">
      <div class="relative aspect-video md:h-full md:aspect-auto md:min-h-[280px] overflow-hidden bg-muted">
        {image ? (
          <img
            src={`${base}/images/projects/${image}`}
            alt={`${title} ${t('projects.imageAlt')}`}
            class="absolute inset-0 w-full h-full object-contain p-6"
            loading="lazy"
          />
        ) : (
          <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-[rgba(104,109,255,0.1)] to-[rgba(182,111,255,0.1)]">
            <span class="text-6xl font-bold text-[#686dff]/20 select-none font-mono">
              {title.slice(0, 2).toUpperCase()}
            </span>
          </div>
        )}
      </div>
    </div>

    <!-- Content -->
    <div class="flex flex-col justify-between p-8 gap-6">
      <!-- Header -->
      <div class="flex flex-col gap-4">
        <!-- Live badge -->
        <div class="flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-xs font-semibold text-emerald-500 tracking-widest uppercase">
            {t('projects.status.active')}
          </span>
        </div>

        <!-- Title & Description -->
        <div class="flex flex-col gap-2">
          <h3 class="text-2xl font-semibold tracking-tight">{title}</h3>
          <p class="text-muted-foreground leading-relaxed">{description}</p>
        </div>

        <!-- Tech Stack Tags -->
        <div class="flex flex-wrap gap-2">
          {tech.map((tag) => (
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-[rgba(104,109,255,0.08)] text-[#686dff] border border-[rgba(104,109,255,0.15)]">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-3">
        {links.site && (
          <a
            href={links.site}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#686dff] text-white text-sm font-medium hover:bg-[#5961ff] transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            </svg>
            {t('projects.viewSite')}
          </a>
        )}
        {links.github && (
          <a
            href={links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border text-sm font-medium text-muted-foreground hover:text-foreground hover:border-foreground/30 transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            {t('projects.viewGitHub')}
          </a>
        )}
      </div>
    </div>
  </div>
</article>
