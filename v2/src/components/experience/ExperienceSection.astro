---
import { getLangFromUrl, getTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang);

type ConcurrentItem = {
  title: string;
  startYear: number;
  endYear: number | null;
  description: string;
};

type RoleEntry = {
  role: string;
  startYear: number;
  endYear: number | null;
  achievements: string[];
  concurrent?: ConcurrentItem[];
};

type ExperienceItem = {
  title: string;
  startYear: number;
  endYear: number | null;
  category: 'work' | 'education';
  // Single-role entry
  role?: string;
  achievements?: string[];
  note?: string;
  // Multi-role entry (career progression at same company)
  roles?: RoleEntry[];
};

const experienceData = await import(`../../data/${lang}/experience.json`);
const items: ExperienceItem[] = experienceData.items ?? experienceData.default?.items ?? [];

const presentLabel = t('experience.present');
const formatPeriod = (start: number, end: number | null) =>
  end === null ? `${start} – ${presentLabel}` : `${start} – ${end}`;

const CATEGORY_LABELS: Record<ExperienceItem['category'], string> = {
  work: t('experience.category.work'),
  education: t('experience.category.education'),
};
---

<section id="experience" aria-labelledby="experience-heading" class="py-24">
  <div class="mx-auto max-w-4xl px-6">
    <!-- Section Heading -->
    <div class="mb-16">
      <h2 id="experience-heading" class="text-3xl font-semibold md:text-4xl">
        {t('experience.heading')}
      </h2>
      <p class="text-muted-foreground mt-3 text-base">{t('experience.subheading')}</p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical gradient line (decorative) -->
      <div
        aria-hidden="true"
        class="absolute top-2 bottom-0 left-[15px] w-px bg-gradient-to-b from-[#686dff] via-[#b66fff] to-transparent md:left-[19px]"
      >
      </div>

      <ul class="space-y-10">
        {
          items.map((item) => (
            <li class="relative flex gap-6 md:gap-8">
              <!-- Timeline dot (decorative) -->
              <div aria-hidden="true" class="relative z-10 mt-1 shrink-0">
                <div class="bg-background flex h-8 w-8 items-center justify-center rounded-full border-2 border-[#686dff] shadow-sm">
                  {item.category === 'education' ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-3.5 w-3.5 text-[#686dff]"
                      aria-hidden="true"
                    >
                      <path d="M10.394 2.08a1 1 0 0 0-.788 0l-7 3a1 1 0 0 0 0 1.84L5.25 8.051a.999.999 0 0 1 .356-.257l4-1.714a1 1 0 1 1 .788 1.838l-2.727 1.17 1.94.831a1 1 0 0 0 .787 0l7-3a1 1 0 0 0 0-1.838l-7-3ZM3.31 9.397 5 10.12v4.102a8.969 8.969 0 0 0-1.05-.174 1 1 0 0 1-.89-.89 11.115 11.115 0 0 1 .25-3.762ZM9.3 16.573A9.026 9.026 0 0 0 10 17a9.026 9.026 0 0 0 .7-.427V13.28L10 13.61l-.7-.329v2.684-.002ZM11 10.12l1.69-.726.001 4.102c-.348.05-.697.121-1.044.204L11 10.12Z" />
                    </svg>
                  ) : (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-3.5 w-3.5 text-[#686dff]"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M6 3.75A2.75 2.75 0 0 1 8.75 1h2.5A2.75 2.75 0 0 1 14 3.75v.443c.572.055 1.14.122 1.706.2C17.053 4.582 18 5.75 18 7.07v3.469c0 1.126-.694 2.191-1.83 2.54-1.952.599-4.024.921-6.17.921s-4.219-.322-6.17-.921C2.694 12.73 2 11.665 2 10.539V7.07c0-1.32.947-2.489 2.294-2.676A41.047 41.047 0 0 1 6 4.193V3.75Zm6.5 0v.325a41.622 41.622 0 0 0-5 0V3.75c0-.69.56-1.25 1.25-1.25h2.5c.69 0 1.25.56 1.25 1.25ZM10 10a1 1 0 0 0-1 1v.01a1 1 0 0 0 1 1h.01a1 1 0 0 0 1-1V11a1 1 0 0 0-1-1H10Z"
                        clip-rule="evenodd"
                      />
                      <path d="M3 15.055v-.684c.126.053.255.1.39.142 2.092.642 4.313.987 6.61.987 2.297 0 4.518-.345 6.61-.987.135-.041.264-.089.39-.142v.684c0 1.347-.985 2.53-2.363 2.686a41.454 41.454 0 0 1-9.274 0C3.985 17.585 3 16.402 3 15.055Z" />
                    </svg>
                  )}
                </div>
              </div>

              <!-- Entry card -->
              <div class="border-border bg-background min-w-0 flex-1 rounded-xl border p-5 shadow-sm transition-shadow hover:shadow-md md:p-6">
                <!-- Card header: company/school name + total period + category badge -->
                <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
                  <h3 class="text-foreground text-base font-semibold leading-snug md:text-lg">
                    {item.title}
                  </h3>
                  <div class="flex shrink-0 flex-col items-end gap-1.5">
                    <span class="text-muted-foreground text-xs tabular-nums">{formatPeriod(item.startYear, item.endYear)}</span>
                    <span class="bg-[rgba(104,109,255,0.08)] inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium text-[#686dff]">
                      {CATEGORY_LABELS[item.category]}
                    </span>
                  </div>
                </div>

                {/* ── Multi-role entry (career progression) ── */}
                {item.roles && item.roles.length > 0 && (
                  <div class="mt-4 space-y-0">
                    {item.roles.map((roleEntry, index) => (
                      <div
                        class:list={[
                          index > 0 && 'border-border mt-4 border-t pt-4',
                        ]}
                      >
                        <!-- Role header: title + period -->
                        <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
                          <p class="text-sm font-medium text-[#686dff]">{roleEntry.role}</p>
                          <span class="text-muted-foreground shrink-0 text-xs tabular-nums">
                            {formatPeriod(roleEntry.startYear, roleEntry.endYear)}
                          </span>
                        </div>

                        <!-- Achievements -->
                        {roleEntry.achievements && roleEntry.achievements.length > 0 && (
                          <ul class="mt-2 space-y-1.5">
                            {roleEntry.achievements.map((achievement) => (
                              <li class="text-foreground/90 flex items-start gap-2 text-sm leading-relaxed">
                                <span aria-hidden="true" class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-[#686dff]" />
                                <span>{achievement}</span>
                              </li>
                            ))}
                          </ul>
                        )}

                        <!-- Concurrent side project(s) -->
                        {roleEntry.concurrent && roleEntry.concurrent.length > 0 && (
                          <div class="mt-3 space-y-1.5">
                            {roleEntry.concurrent.map((side) => (
                              <div class="flex items-start gap-2 rounded-lg bg-[rgba(182,111,255,0.07)] px-3 py-2">
                                <span class="mt-0.5 shrink-0 inline-flex items-center rounded-full bg-[rgba(182,111,255,0.15)] px-2 py-0.5 text-xs font-medium text-[#b66fff]">
                                  {t('experience.sideProject')}
                                </span>
                                <div class="min-w-0">
                                  <span class="text-xs font-medium text-[#b66fff]">{side.title}</span>
                                  <span class="text-muted-foreground mx-1 text-xs">·</span>
                                  <span class="text-muted-foreground text-xs tabular-nums">{formatPeriod(side.startYear, side.endYear)}</span>
                                  <p class="text-foreground/80 mt-0.5 text-xs leading-relaxed">{side.description}</p>
                                </div>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                )}

                {/* ── Single-role entry ── */}
                {item.role && (
                  <p class="mt-0.5 text-sm font-medium text-[#686dff]">{item.role}</p>
                )}
                {item.achievements && item.achievements.length > 0 && (
                  <ul class="mt-3 space-y-1.5">
                    {item.achievements.map((achievement) => (
                      <li class="text-muted-foreground flex items-start gap-2 text-sm leading-relaxed">
                        <span aria-hidden="true" class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-[#686dff]" />
                        <span>{achievement}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {/* ── Optional footnote (e.g. part-time work during studies) ── */}
                {item.note && (
                  <p class="text-foreground/60 mt-3 border-t border-dashed pt-3 text-xs leading-relaxed border-border/50">
                    {item.note}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
