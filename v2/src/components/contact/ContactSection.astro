---
import { getLangFromUrl, getTranslations } from '@/i18n/utils';
import socialData from '@/data/social.json';
import SectionHeading from '@/components/common/SectionHeading.astro';
import SectionContainer from '@/components/common/SectionContainer.astro';
import SurfaceCard from '@/components/common/SurfaceCard.astro';
import OverlineLabel from '@/components/common/OverlineLabel.astro';
import PillBadge from '@/components/common/PillBadge.astro';
import SocialLinkItem from '@/components/common/SocialLinkItem.astro';

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang);
---

<SectionContainer id="contact" ariaLabelledby="contact-heading">
    <!-- Heading -->
    <SectionHeading id="contact-heading" level="h2" heading={t('contact.heading')} titleOnly />

    <div class="grid gap-12 md:grid-cols-2">
      <!-- Availability -->
      <SurfaceCard padding="lg" tone="background">
        <div class="mb-4 flex items-center gap-3">
          <span class="relative flex h-3 w-3">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
            ></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-emerald-500"></span>
          </span>
          <PillBadge tone="success">{t('contact.availability.label')}</PillBadge>
        </div>
        <p class="text-foreground text-xl font-semibold">
          {t('contact.availability.status')}
        </p>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          {t('contact.availability.detail')}
        </p>
      </SurfaceCard>

      <!-- Social Links -->
      <SurfaceCard padding="lg" tone="background">
        <OverlineLabel text={t('contact.connect.label')} class="mb-6" />
        <div class="flex flex-col gap-4">
          {
            socialData.links.map((link) => (
              <SocialLinkItem link={link} />
            ))
          }
        </div>
      </SurfaceCard>
    </div>
</SectionContainer>
