---
import { getLangFromUrl, getTranslations } from '@/i18n/utils';
import ToolMarquee from './ToolMarquee';

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang);

const data = await import(`../../data/${lang}/ai-tools.json`);
const toolsData = data.default ?? data;
const tools: {
  id: string;
  name: string;
  category: string;
  description: string;
  logoUrl: string;
  url: string;
}[] = toolsData.items ?? [];

// Strip the "All" / "すべて" sentinel — marquee rows are self-organising
const allLabel = t('aiToolkit.filter.all');
const categories: string[] = (toolsData.categories ?? []).filter((c: string) => c !== allLabel);
---

<section id="ai-toolkit" class="overflow-hidden py-24">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Section heading -->
    <div class="mb-12">
      <h2 class="text-foreground text-3xl font-semibold tracking-tight md:text-4xl">
        {t('aiToolkit.heading')}
      </h2>
      <p class="text-muted-foreground mt-3 max-w-xl text-base">
        {t('aiToolkit.subheading')}
      </p>
    </div>
  </div>

  <!-- Full-width marquee (bleeds past the max-w container intentionally) -->
  <div class="px-6">
    <ToolMarquee client:visible categories={categories} tools={tools} />
  </div>
</section>
