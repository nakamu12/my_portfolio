---
import { getLangFromUrl, getTranslations } from '@/i18n/utils';
import ToolGrid from './ToolGrid';

const lang = getLangFromUrl(Astro.url);
const t = await getTranslations(lang);

const data = await import(`../../data/${lang}/ai-tools.json`);
const toolsData = data.default ?? data;
const tools: {
  id: string;
  name: string;
  category: string;
  description: string;
  logoUrl: string;
  url: string;
}[] = toolsData.items ?? [];

const allLabel = t('aiToolkit.filter.all');
const categories: string[] = toolsData.categories ?? [];
---

<section id="ai-toolkit" class="relative overflow-hidden py-24">
  <!-- Dot grid background -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(circle, #686dff 1px, transparent 1px); background-size: 28px 28px;"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-6">
    <!-- Section heading -->
    <div class="mb-12">
      <h2
        class="bg-gradient-to-r from-[#686dff] to-[#b66fff] bg-clip-text text-3xl font-semibold tracking-tight text-transparent md:text-4xl"
      >
        {t('aiToolkit.heading')}
      </h2>
      <p class="text-muted-foreground mt-3 max-w-xl text-base">
        {t('aiToolkit.subheading')}
      </p>
    </div>

    <!-- Icon grid with category filter -->
    <ToolGrid client:visible categories={categories} tools={tools} allLabel={allLabel} />
  </div>
</section>
