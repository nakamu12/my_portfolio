---
// Root page: detect browser language and redirect
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<html>
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting...</title>
    <script is:inline define:vars={{ base: base }}>
      (function () {
        var stored = localStorage.getItem('lang');
        if (stored) {
          window.location.replace(base + stored + '/');
          return;
        }
        var browserLang = navigator.language || 'en';
        var lang = browserLang.startsWith('ja') ? 'ja' : 'en';
        window.location.replace(base + lang + '/');
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content={"0;url=" + base + "en/"} />
    </noscript>
  </head>
  <body></body>
</html>
