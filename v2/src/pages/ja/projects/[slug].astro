---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getTranslations } from '@/i18n/utils';

export async function getStaticPaths() {
  const { items } = (await import('../../../data/ja/projects.json')) as {
    items: Array<{
      slug: string;
      title: string;
      description: string;
      tech: string[];
      image: string | null;
      status: 'active' | 'archived';
      period: string;
      links: { site: string | null; github: string | null };
      caseStudy: {
        challenge: string;
        approach: string;
        techDetails: string;
        outcome: string;
      };
    }>;
  };

  return items.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const t = await getTranslations('ja');

const sections = [
  { key: 'projects.challenge', content: project.caseStudy.challenge },
  { key: 'projects.approach', content: project.caseStudy.approach },
  { key: 'projects.techDetails', content: project.caseStudy.techDetails },
  { key: 'projects.outcome', content: project.caseStudy.outcome },
] as const;
---

<BaseLayout title={`${project.title} | 中村 亮太`} description={project.description}>
  <Header />
  <main class="pt-24 pb-24">
    <div class="mx-auto max-w-3xl px-6">
      <!-- Back Link -->
      <a
        href="/ja/#projects"
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors duration-200 mb-12"
      >
        {t('projects.backToProjects')}
      </a>

      <!-- Hero -->
      <header class="mb-16">
        <!-- Thumbnail -->
        {project.image ? (
          <div class="rounded-xl overflow-hidden aspect-video mb-10 bg-muted">
            <img
              src={`/images/projects/${project.image}`}
              alt={project.title}
              class="w-full h-full object-cover"
            />
          </div>
        ) : (
          <div class="rounded-xl aspect-video mb-10 flex items-center justify-center bg-gradient-to-br from-[rgba(104,109,255,0.08)] to-[rgba(182,111,255,0.08)] border border-border">
            <span class="text-7xl font-bold text-[#686dff]/20 select-none font-mono">
              {project.title.slice(0, 2).toUpperCase()}
            </span>
          </div>
        )}

        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">
            {project.title}
          </h1>
          {project.status === 'archived' && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-muted border border-border text-sm font-medium text-muted-foreground">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/>
              </svg>
              {t('projects.status.archived')}
            </span>
          )}
          <span class="text-sm font-mono text-muted-foreground">{project.period}</span>
        </div>
        <p class="text-lg text-muted-foreground leading-relaxed">
          {project.description}
        </p>
      </header>

      <!-- Tech & Links -->
      <div class="flex flex-col sm:flex-row gap-6 mb-16 pb-16 border-b border-border">
        <div class="flex-1">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-3">
            {t('projects.techUsed')}
          </p>
          <div class="flex flex-wrap gap-2">
            {project.tech.map((tag) => (
              <span class="inline-flex items-center px-3 py-1 rounded-md text-sm font-medium bg-[rgba(104,109,255,0.08)] text-[#686dff] border border-[rgba(104,109,255,0.15)]">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-3">
            {t('projects.links')}
          </p>
          <div class="flex flex-col gap-2">
            {project.links.site && (
              <a
                href={project.links.site}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-medium text-[#686dff] hover:text-[#5961ff] transition-colors duration-200"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                </svg>
                {t('projects.viewSite')}
              </a>
            )}
            {project.links.github && (
              <a
                href={project.links.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors duration-200"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                {t('projects.viewGitHub')}
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Case Study Sections -->
      <div class="flex flex-col gap-14">
        {sections.map(({ key, content }) => (
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-1 h-5 rounded-full bg-gradient-to-b from-[#686dff] to-[#b66fff]"></div>
              <h2 class="text-xl font-semibold">{t(key)}</h2>
            </div>
            <p class="text-muted-foreground leading-relaxed">{content}</p>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
